{
  "name": "@pranitmodi/code-intel",
  "version": "0.3.2",
  "description": "Local code index for AI coding agents: MCP server that gives Cursor, VS Code Copilot, and other agents ranked, token-budgeted context instead of whole-repo scans.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "cursor",
    "vscode",
    "github-copilot",
    "copilot",
    "coding-agents",
    "code-search",
    "semantic-search",
    "context-retrieval",
    "token-optimization",
    "embeddings",
    "ollama",
    "lancedb",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pranitmodi/code-intel.git"
  },
  "bugs": {
    "url": "https://github.com/pranitmodi/code-intel/issues"
  },
  "homepage": "https://github.com/pranitmodi/code-intel#readme",
  "engines": {
    "node": ">=20.9"
  },
  "bin": {
    "code-intel": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "docs/ARCHITECTURE.md",
    "docs/BENCHMARKS.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "link": "npm run build && npm link",
    "onboard": "node dist/cli/index.js onboard",
    "benchmark:retrieval": "tsx src/cli/index.ts benchmark --format json",
    "sync:guidance": "tsx scripts/sync-agent-guidance.mts",
    "prepublishOnly": "npm run build && npm run test:unit"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.39.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@parcel/watcher": "^2.6.0",
    "@tree-sitter-grammars/tree-sitter-yaml": "^0.7.1",
    "apache-arrow": "18.0.0",
    "commander": "^15.0.0",
    "ignore": "^7.0.8",
    "js-yaml": "^5.4.1",
    "jsonc-parser": "^3.3.1",
    "ollama": "^0.6.3",
    "tree-sitter-bash": "^0.25.1",
    "tree-sitter-css": "^0.25.0",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-html": "^0.23.2",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-json": "^0.24.8",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.27.0",
    "zod": "^4.5.4"
  },
  "overrides": {
    "@huggingface/transformers": "4.3.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
